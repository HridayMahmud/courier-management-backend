# Copy this file to .env and fill in the values.

# Required -------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas or a local server)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/courier
# Any long random string, used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Optional -------------------------------------------------------------
PORT=4000

# Email for "forgot password".
# Without EMAIL_USER/EMAIL_PASS the reset email is printed in this terminal instead of sent.
# EMAIL_PASS is a Gmail App Password, not your normal Gmail password.
EMAIL_USER=
EMAIL_PASS=
# gmail | console | ethereal (leave empty to choose automatically)
MAIL_TRANSPORT=

# First admin account, created by `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
