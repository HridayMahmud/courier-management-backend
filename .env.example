# Copy this file to .env and fill in the values.

# Required -------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas or a local server)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/courier
# Any long random string, used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Optional -------------------------------------------------------------
PORT=4000

# Email for "forgot password". Without any of these the email is printed in this terminal.
# Brevo (HTTP API, works on Render free which blocks SMTP): API key + a sender verified in Brevo
BREVO_API_KEY=
EMAIL_FROM=SwiftShip <you@example.com>
# Or Gmail SMTP (not on Render free): EMAIL_PASS is a Gmail App Password
EMAIL_USER=
EMAIL_PASS=
# brevo | gmail | console | ethereal | off (leave empty to choose automatically)
MAIL_TRANSPORT=

# Login/register/password-reset limits per IP. Set to off while running automated tests.
RATE_LIMIT=on

# First admin account, created by `npm run seed`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
